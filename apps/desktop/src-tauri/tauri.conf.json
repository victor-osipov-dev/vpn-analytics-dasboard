{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetScope",
  "version": "0.1.0",
  "identifier": "com.netscope.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NetScope — Internet & VPN Analytics",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Local-first internet, VPN and blocking analytics",
    "longDescription": "NetScope measures service availability over DIRECT and VPN routes, detects filtering and stores a local history.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
